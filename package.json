{
  "name": "clitemplate",
  "version": "0.1.0",
  "description": "A cross-platform Node.js CLI template",
  "type": "module",
  "bin": {
    "clitemplate": "bin/clitemplate.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "npm run clean && npm run build",
    "link": "npm run build && npm link"
  },
  "keywords": [
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
