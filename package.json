{
  "name": "clitemplate",
  "version": "0.1.0",
  "description": "A cross-platform Node.js CLI template",
  "type": "module",
  "bin": {
    "clitemplate": "bin/clitemplate.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node src/run.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"for (const d of ['dist','dist-exe','build']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "npm run clean && npm run build",
    "link": "npm run build && npm link",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "keywords": [
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3"
  }
}
